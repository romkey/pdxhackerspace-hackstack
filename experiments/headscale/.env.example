# Pin the image. A database schema migration between versions can break startup,
# so avoid `latest` (see https://github.com/juanfont/headscale/releases )
IMAGE_VERSION=v0.29.3

# Optional
# TZ=America/Los_Angeles

# Almost everything is configured in config/config.yaml, not here.
#
# Viper (the config library headscale uses) also reads HEADSCALE_-prefixed
# environment variables, with __ nesting flattened to _, and they win over the
# config file. This is not documented upstream, so treat it as a convenience for
# keeping the OIDC client secret out of config/ rather than the main way to
# configure the service.
# HEADSCALE_OIDC_CLIENT_SECRET=

# BACKUP_DATABASE_URLS — the SQLite database lives at /opt/lib/headscale/db.sqlite
# on the server. Set it only in your real .env if you want db-backup to dump it;
# do not define BACKUP_DATABASE_URLS in .env.example.

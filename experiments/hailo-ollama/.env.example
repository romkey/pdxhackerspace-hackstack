# Image loaded with `docker load` from the Hailo Developer Zone zip (not pullable from a registry).
# Run `docker images | grep hailo` after loading to see the name and tag.
#IMAGE_NAME=hailo_docker_hailort_ub2204
IMAGE_VERSION=<loaded image tag>

# Hailo-10H device node on the host. Hailo's docs use /dev/h1x-0; check `ls /dev | grep -E 'h1x|hailo'`.
#HAILO_DEVICE=/dev/h1x-0

# Bind address inside the container (default 0.0.0.0:8000)
#OLLAMA_HOST=0.0.0.0:8000

# Set to share the Hailo device with other HailoRT apps (e.g. SHARED)
#HAILO_OLLAMA_VDEVICE_GROUP_ID=SHARED

TZ=America/Los_Angeles

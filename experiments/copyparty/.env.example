# Container image tag (see https://hub.docker.com/r/copyparty/ac/tags )
# copyparty/ac is the recommended image (thumbnails for images/audio/video, no transcoding extras)
IMAGE_VERSION=latest

# Host user/group that owns ../../lib/copyparty (the container runs as this user)
PUID=1000
PGID=1000

# Optional
# TZ=America/Los_Angeles

# --- Optional: shared files (/w) on NFS ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.nfs.yml
# COPYPARTY_NFS_HOST=
# COPYPARTY_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

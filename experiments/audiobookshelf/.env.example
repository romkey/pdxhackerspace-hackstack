IMAGE_VERSION=latest

# --- Optional: libraries on NFS ---
# Default: ../../lib/audiobookshelf/{audiobooks,podcasts}. For NAS exports instead,
# uncomment COMPOSE_FILE and set both library pairs (can be the same server):
# COMPOSE_FILE=docker-compose.yml:docker-compose.nfs.yml
# AUDIOBOOKS_NFS_HOST=
# AUDIOBOOKS_NFS_PATH=
# PODCASTS_NFS_HOST=
# PODCASTS_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

IMAGE=ghcr.io/romkey/comfyui-docker:latest

CLI_ARGS=--listen 0.0.0.0 --fast fp8_matrix_mult

# ---- resource fencing -----------------------------------------------------
# GB of the 128 GB unified pool to leave alone for the vLLM container.
# ~18 GB for Qwen3.8-27B at NVFP4 + KV cache + slack. Raise if you set a
# large max-model-len on the LLM side.
COMFYUI_RESERVE_VRAM_GB=30
COMFYUI_VRAM_MODE=highvram

# ---- huggingface ----------------------------------------------------------
# Read-only token. Avoids rate limiting on a 42.5 GB pull.
#HF_TOKEN=
HF_ENDPOINT=http://hf-mirror.ctrlh
HF_DEBUG=0

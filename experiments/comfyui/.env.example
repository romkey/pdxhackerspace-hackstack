IMAGE_VERSION=latest
TZ=America/Los_Angeles

CLI_ARGS=--listen 0.0.0.0 --disable-xformers

# ---- resource fencing -----------------------------------------------------
# GB of the 128 GB unified pool to leave alone for the vLLM container.
# ~18 GB for Qwen3.8-27B at NVFP4 + KV cache + slack. Raise if you set a
# large max-model-len on the LLM side.
RESERVE_VRAM_GB=30

GPU_COUNT=1

# ---- huggingface ----------------------------------------------------------
# Read-only token. Avoids rate limiting on a 42.5 GB pull.
HF_TOKEN=
HF_ENDPOINT=https://huggingface.co

PUID=1000
PGID=1000
NVIDIA_VISIBLE_DEVICES=all

# --- Optional: ComfyUI data (including models/) on NFS ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.nfs.yml
# COMFYUI_NFS_HOST=
# COMFYUI_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

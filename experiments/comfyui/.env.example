# ==== hardware: pick exactly one COMPOSE_FILE line ===========================
# See README "Choosing compose files". Add :docker-compose.nfs.yml to the end of
# any line to keep /data on NFS.

# NVIDIA, CUDA 13 (driver >= 580): discrete GPUs, DGX Spark, Jetson Thor
COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# NVIDIA, CUDA 12.8 (driver >= 570)
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.nvidia-cu128.yml
# NVIDIA Blackwell with SageAttention (DGX Spark GB10, RTX 50, B200; not Jetson Thor)
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.nvidia-sage.yml
# AMD Strix Halo / Ryzen AI Max (gfx1151), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.rocm.yml
# Intel Arc (B580, Arc Pro B70, A-series), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.xpu.yml
# CPU only (no GPU, or Docker Desktop on macOS)
# COMPOSE_FILE=docker-compose.yml

# ComfyUI release (e.g. 0.38.0) or latest. The compose file adds the hardware
# suffix (-cpu, -cu128, -sage, -rocm-gfx1151, -xpu), so don't include it here.
IMAGE_VERSION=latest

# ==== container ===============================================================
TZ=America/Los_Angeles
# Owner of ../../lib/comfyui on the host
PUID=1000
PGID=1000
# COMFYUI_CHOWN_DATA=false          # true = recursively chown /data to PUID:PGID at start

# ==== ComfyUI (all backends) ==================================================
# COMFYUI_CPU=auto                  # auto (CPU if no GPU is found) | true | false
# COMFYUI_VRAM_MODE=                # gpu-only | highvram | normalvram | lowvram | novram
# COMFYUI_RESERVE_VRAM=             # GB of VRAM to leave free for other processes
# COMFYUI_FAST=                     # all, or a list: fp16_accumulation,fp8_matrix_mult,cublas_ops,autotune
# COMFYUI_ATTENTION=                # pytorch | split | quad | sage | flash | auto
# COMFYUI_PREVIEW_METHOD=           # none | auto | latent2rgb | taesd
# COMFYUI_CACHE_LRU=                # keep N node results instead of only the last
# COMFYUI_CACHE_NONE=false          # true = reload models every run, less memory pressure
# COMFYUI_MAX_UPLOAD_SIZE=100       # MB
# COMFYUI_FORCE_FP16=false
# COMFYUI_FORCE_FP32=false
# COMFYUI_BF16_VAE=false
# COMFYUI_DISABLE_MMAP=false
# COMFYUI_DISABLE_SMART_MEMORY=false
# COMFYUI_HIGH_RAM=false
# COMFYUI_DETERMINISTIC=false
# COMFYUI_VERBOSE_DEBUG=false
# COMFYUI_ENABLE_MANAGER=true
# COMFYUI_INSTALL_NODE_REQUIREMENTS=false   # pip install each custom node's requirements.txt at start
# COMFYUI_CORS_ORIGIN=
# COMFYUI_ARGS=                     # any extra raw ComfyUI arguments
# Load config/extra_model_paths.yaml (mounted at /config) for extra model roots:
# COMFYUI_EXTRA_MODEL_PATHS_CONFIG=/config/extra_model_paths.yaml

# ==== NVIDIA (docker-compose.nvidia.yml and its -cu128 / -sage layers) ========
# GPUs reserved for the container: all, or a number
GPU_COUNT=all
NVIDIA_VISIBLE_DEVICES=all
# all includes video, which ffmpeg/NVENC in video workflows needs
NVIDIA_DRIVER_CAPABILITIES=all
# COMFYUI_CUDA_DEVICE=              # pin ComfyUI to one device index, e.g. 0
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# The -sage image defaults COMFYUI_ATTENTION to auto (Sage only on sm_100/120/121);
# set COMFYUI_ATTENTION=pytorch to turn it off.

# --- DGX Spark (GB10, 128 GB unified memory) ----------------------------------
# Use the -sage COMPOSE_FILE line above.
# COMFYUI_VRAM_MODE=highvram        # offloading to "CPU RAM" is a pointless copy on unified memory
# COMFYUI_RESERVE_VRAM=30           # GB left for the OS and a co-resident vLLM (~18 GB for Qwen3.8-27B NVFP4 + KV cache)
# COMFYUI_FAST=fp8_matrix_mult      # faster FP8 models on Blackwell; benchmark before keeping

# --- Jetson Thor (128 GB unified memory) --------------------------------------
# Use the plain NVIDIA line, not -sage. On the host: sudo nvpmodel -m 0 && sudo jetson_clocks
# COMFYUI_VRAM_MODE=highvram
# COMFYUI_RESERVE_VRAM=16
# COMFYUI_FAST=fp8_matrix_mult

# ==== AMD ROCm (docker-compose.rocm.yml) ======================================
# The image already defaults to the Strix Halo settings below; override here.
# COMFYUI_DISABLE_MMAP=true         # avoids very slow or hanging loads above 64 GB
# COMFYUI_BF16_VAE=true             # avoids OOM while decoding
# COMFYUI_CACHE_NONE=true           # helps when unified memory is tight
# HSA_OVERRIDE_GFX_VERSION=11.5.1
# HSA_ENABLE_SDMA=0
# HSA_USE_SVM=0
# HIP_VISIBLE_DEVICES=0
# PYTORCH_HIP_ALLOC_CONF=expandable_segments:True

# ==== Intel Arc XPU (docker-compose.xpu.yml) ==================================
# Pick one card on a multi-GPU host (index from torch.xpu, see README)
# COMFYUI_ONEAPI_DEVICE_SELECTOR=level_zero:0
# Arc B580 (12 GB) with large models:
# COMFYUI_VRAM_MODE=lowvram
# Black or noisy images on Arc Pro B70: try --fp32-vae first, then force fp32
# COMFYUI_ARGS=--fp32-vae
# COMFYUI_FORCE_FP32=true
# JIT kernel caches (already set in the image; kept on the data volume)
# SYCL_CACHE_DIR=/data/cache/sycl
# NEO_CACHE_DIR=/data/cache/neo

# ==== Hugging Face ============================================================
# Read-only token, needed for gated models and avoids rate limits on big pulls
# HF_TOKEN=
HF_ENDPOINT=http://hf-mirror.ctrlh
HF_DEBUG=0

# ==== bundled / preloaded custom nodes ========================================
# COMFYUI_BUNDLED_NODES=all         # all | none | comma list: comfier_agent,ComfyUI-VideoHelperSuite
# COMFYUI_PRELOAD_NODES=            # git URLs (optionally URL@ref), cloned on first start

# ==== Comfier agent (idle until both are set; see experiments/comfierui) ======
# COMFIER_URL=https://slop.pdxhackerspace.org
# COMFIER_API_KEY=

# ==== optional: /data on NFS (append :docker-compose.nfs.yml to COMPOSE_FILE) =
# COMFYUI_NFS_HOST=
# COMFYUI_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

# Container image tag (https://github.com/romkey/olah-docker/pkgs/container/olah-docker )
#   latest   newest Olah release (rebuilt automatically when PyPI has a new one)
#   X.Y.Z    exact Olah release, e.g. 0.5.1
# Cached data is NOT portable between Olah versions: empty the cache before upgrading.
IMAGE_VERSION=latest

# Address clients use to reach this mirror, host[:port] and no scheme. Olah
# rewrites Hugging Face URLs to point here, so it must match the hostname
# served by nginx-proxy-manager.
OLAH_MIRROR_NETLOC=olah.pdxhackerspace.org
# https when fronted by nginx-proxy-manager with TLS, http otherwise
OLAH_MIRROR_SCHEME=https

# Optional cache ceiling, e.g. 500GB or 2TB. Empty = unlimited. Olah scans the
# cache hourly and evicts per cache-clean-strategy in config/configs.toml.
OLAH_CACHE_SIZE_LIMIT=

# Do NOT set WEB_CONCURRENCY: Olah runs a single worker here, and uvicorn reads
# that variable and warns "You must pass the application as an import string to
# enable 'reload' or 'workers'". Multiple workers need `--workers N` instead,
# with every setting in config/configs.toml rather than command-line flags.

# Optional: timezone inside the container
# TZ=America/Los_Angeles

# --- Storage: model cache over NFS (required) ---
# The cache (/data/repos) is mounted from this share by a Docker NFS volume.
# NFS server (hostname or IP) exporting the cache directory
OLAH_NFS_HOST=

# Export path on that server, e.g. /export/olah
OLAH_NFS_PATH=

# Mount options appended after `addr=<host>,rw`
NFS_MOUNT_OPTS=nfsvers=4,hard

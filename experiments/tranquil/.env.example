# Container image tag (see https://tangled.org/tranquil.farm/tranquil-pds )
IMAGE_VERSION=latest

# Public hostname served by the reverse proxy (TLS terminates at the proxy).
PDS_HOSTNAME=tranquil.pdxhackerspace.org
PDS_USER_HANDLE_DOMAINS=.pdxhackerspace.org

# Listen on all interfaces inside the container (default 127.0.0.1 is not reachable from the proxy).
SERVER_HOST=[::]

# One reverse proxy (nginx-proxy) in front of Tranquil.
TRUSTED_PROXY_COUNT=1

# PostgreSQL (create with ../../apps/postgresql/bin/mkdb.sh tranquil).
DATABASE_URL=postgres://tranquil_user:CHANGE-ME@postgresql/tranquil_db

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
DPOP_SECRET=
# openssl rand -base64 48
MASTER_KEY=

INVITE_CODE_REQUIRED=true

# Optional: skip verified-comms gate only for invite-only or lab PDSes.
#DISABLE_ACCOUNT_VERIFICATION_GATE=true

# Optional email (verification, password reset). See config/config.toml.default [email] for more.
#MAIL_FROM_ADDRESS=noc@pdxhackerspace.org
#MAIL_SMARTHOST_HOST=smtp.example.com
#MAIL_SMARTHOST_PORT=587
#MAIL_SMARTHOST_USERNAME=
#MAIL_SMARTHOST_PASSWORD=

# Optional Bluesky moderation relay (defaults in config.toml when unset).
#REPORT_SERVICE_URL=https://mod.bsky.app
#REPORT_SERVICE_DID=

# BACKUP_DATABASE_URLS — apps/postgresql/bin/mkdb.sh appends this to .env when you
# create the app database (unless .env already defines it). Do not define BACKUP_DATABASE_URLS in .env.example.

IMAGE_VERSION=latest
TZ=America/Los_Angeles

# Settings below override config/grafana.ini as GF_<SECTION>_<KEY>.
# See https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/

# --- Server / reverse proxy ---
GF_SERVER_ROOT_URL=https://grafana.example.com

# --- Admin account (only applied when the admin user is first created) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<FILL IN>
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false

# --- Database (shared PostgreSQL; create it first - see README) ---
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=postgresql:5432
GF_DATABASE_NAME=grafana_db
GF_DATABASE_USER=grafana_user
GF_DATABASE_PASSWORD=<DATABASE PASSWORD>
GF_DATABASE_SSL_MODE=disable

# --- Optional: log in with authentik (OIDC) - see README ---
# Redirect URI to register in authentik: <GF_SERVER_ROOT_URL>/login/generic_oauth
# GF_AUTH_GENERIC_OAUTH_ENABLED=true
# GF_AUTH_GENERIC_OAUTH_NAME=authentik
# GF_AUTH_GENERIC_OAUTH_CLIENT_ID=<FILL IN>
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=<FILL IN>
# GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
# GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.example.com/application/o/authorize/
# GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.example.com/application/o/token/
# GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.example.com/application/o/userinfo/
# GF_AUTH_SIGNOUT_REDIRECT_URL=https://auth.example.com/application/o/grafana/end-session/
# GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
# GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
# GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
# Map authentik groups to Grafana roles; everyone else gets Viewer
# GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups, 'Grafana Admins') && 'Admin' || contains(groups, 'Grafana Editors') && 'Editor' || 'Viewer'
# Create Grafana accounts on first OIDC login (separate from GF_USERS_ALLOW_SIGN_UP)
# GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
# Skip the Grafana login page and go straight to authentik
# GF_AUTH_OAUTH_AUTO_LOGIN=false
# Hide the username/password form once OIDC works (keep the admin login until then)
# GF_AUTH_DISABLE_LOGIN_FORM=false

# BACKUP_DATABASE_URLS — apps/postgresql/bin/mkdb.sh or apps/mariadb/bin/mkdb.sh appends this to .env when you
# create the app database (unless .env already defines it). For SQLite or other URLs, set it only in your
# real .env. Do not define BACKUP_DATABASE_URLS in .env.example.

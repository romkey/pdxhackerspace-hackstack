# Copy to .env and adjust for local development.

IMAGE_VERSION=latest
REDIS_IMAGE_VERSION=8
RAILS_ENV=production

# Database (docker-compose.dev defaults)
DB_HOST=postgresql
DB_PORT=5432
DB_USERNAME=links_user
DB_PASSWORD=PASSWORD
DB_NAME=links_db

# Redis (docker-compose.dev defaults)
REDIS_URL=redis://links-redis:6379/0

# App
APP_HOST=http://links.pdxhackerspace.org
# APP_VERSION is set automatically in Docker builds from git tags.

# CUPS print server (hostname:port). Docker dev defaults to host.docker.internal:631.
CUPS_SERVER=chaos:631

# Local sign-in (optional — one account from environment)
LOCAL_AUTH_EMAIL=admin@pdxhackerspace.org
LOCAL_AUTH_PASSWORD=PASSWORD
LOCAL_AUTH_NAME=Local Admin

# OpenID Connect (optional — omit to use local sign-in only)
OIDC_ISSUER=https://auth.pdxhackerspace.org/application/o/links-app/
OIDC_CLIENT_ID=CLIENT_ID
OIDC_CLIENT_SECRET=CLIENT_SECRET
OIDC_REDIRECT_URI=https://links.pdxhackerspace.org/auth/openid_connect/callback

# NFC tag writing (optional — max estimated NDEF bytes for Android dual-record writes)
# NFC_TAG_MAX_BYTES=496

# Reverse proxy trust (comma-separated CIDR blocks or IPs that may set X-Forwarded-For)
TRUSTED_REVERSE_PROXIES==172.16.1.20

# Anonymous read-only access from trusted networks (comma-separated CIDR blocks or IPs)
NETWORK_WHITELIST=192.168.0.0/16

# Production
DATABASE_URL=postgres://links_user:PASSWORD@postgresql/links_db
# RAILS_MASTER_KEY=
SECRET_KEY_BASE=MASTER_ KEY

# Error monitoring (optional — production/staging only)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

SHORT_URL=http://l.ctrlh

# BACKUP_DATABASE_URLS — apps/postgresql/bin/mkdb.sh or apps/mariadb/bin/mkdb.sh appends this to .env when you
# create the app database (unless .env already defines it). For SQLite or other URLs, set it only in your
# real .env. Do not define BACKUP_DATABASE_URLS in .env.example.

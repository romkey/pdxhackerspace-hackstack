# Container image tag (see https://codeberg.org/forgejo/-/packages/container/forgejo/versions )
# Pin to a major version (e.g. 12) in production: major upgrades run one-way
# database migrations and should be done deliberately, one major at a time.
IMAGE_VERSION=latest

# Host user/group that owns ../../lib/forgejo (the container drops to this uid/gid)
USER_UID=1000
USER_GID=1000

# Optional: timezone inside the container
# TZ=America/Los_Angeles

# Everything below maps to app.ini as FORGEJO__<section>__<KEY>.
# On first start these are written into ../../lib/forgejo/gitea/conf/app.ini;
# changes here are re-applied on restart.
# See https://forgejo.org/docs/latest/admin/config-cheat-sheet/

# --- Database (shared PostgreSQL; create it first - see README) ---
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=postgresql:5432
FORGEJO__database__NAME=forgejo_db
FORGEJO__database__USER=forgejo_user
# Password printed by apps/postgresql/bin/mkdb.sh. Do not commit real values.
FORGEJO__database__PASSWD=
FORGEJO__database__SSL_MODE=disable

# --- Server / reverse proxy ---
FORGEJO__server__PROTOCOL=http
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__DOMAIN=git.pdxhackerspace.org
FORGEJO__server__ROOT_URL=https://git.pdxhackerspace.org/
# Git over SSH. Clone URLs advertise SSH_DOMAIN:SSH_PORT, which must match the
# published port in docker-compose.yml (2222 by default). Leave START_SSH_SERVER
# false and keep the port commented out if you only want HTTPS clones.
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__SSH_DOMAIN=git.pdxhackerspace.org
FORGEJO__server__SSH_PORT=2222
FORGEJO__server__LFS_START_SERVER=true

# --- Accounts ---
# Skips the web installer; configure everything here instead.
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
FORGEJO__service__ENABLE_NOTIFY_MAIL=false
FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false

# --- Mail (optional; relay through apps/postfix) ---
# FORGEJO__mailer__ENABLED=true
# FORGEJO__mailer__PROTOCOL=smtp
# FORGEJO__mailer__SMTP_ADDR=postfix
# FORGEJO__mailer__SMTP_PORT=25
# FORGEJO__mailer__FROM=git@pdxhackerspace.org

# --- Misc ---
FORGEJO__cron__ENABLED=true
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__log__LEVEL=info

# BACKUP_DATABASE_URLS — apps/postgresql/bin/mkdb.sh or apps/mariadb/bin/mkdb.sh appends this to .env when you
# create the app database (unless .env already defines it). For SQLite or other URLs, set it only in your
# real .env. Do not define BACKUP_DATABASE_URLS in .env.example.

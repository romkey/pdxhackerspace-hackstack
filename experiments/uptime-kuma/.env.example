# Image tag. `latest` is deprecated upstream and still points at v1, so pin the
# major version instead (see https://github.com/louislam/uptime-kuma/wiki/Docker-Tags )
IMAGE_VERSION=2

# Optional
# TZ=America/Los_Angeles

# Uptime Kuma stores its data in SQLite under /app/data by default. The only alternative
# is MariaDB/MySQL — PostgreSQL is not supported upstream (see README). To use the shared
# MariaDB, create the database first (see README) and uncomment these plus the mariadb
# network in docker-compose.yml. Only works on a fresh install.
# UPTIME_KUMA_DB_TYPE=mariadb
# UPTIME_KUMA_DB_HOSTNAME=mariadb
# UPTIME_KUMA_DB_PORT=3306
# UPTIME_KUMA_DB_NAME=uptimekuma_db
# UPTIME_KUMA_DB_USERNAME=uptimekuma_user
# UPTIME_KUMA_DB_PASSWORD=

# Uncomment if the reverse proxy serves Uptime Kuma under a hostname that does not
# match the Origin header the browser sends (see https://github.com/louislam/uptime-kuma/wiki/Environment-Variables )
# UPTIME_KUMA_WS_ORIGIN_CHECK=bypass

# BACKUP_DATABASE_URLS — apps/mariadb/bin/mkdb.sh appends this to .env when you create the app
# database (unless .env already defines it). Do not define BACKUP_DATABASE_URLS in .env.example.

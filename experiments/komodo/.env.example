IMAGE_VERSION=2
MONGO_IMAGE_VERSION=latest
TZ=America/Los_Angeles

# MongoDB - root user is created on first start
MONGO_INITDB_ROOT_USERNAME=komodo
MONGO_INITDB_ROOT_PASSWORD=<DATABASE PASSWORD>

# Komodo Core - full list: https://github.com/moghtech/komodo/blob/main/config/core.config.toml
KOMODO_DATABASE_ADDRESS=komodo-mongo:27017
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=<DATABASE PASSWORD>

KOMODO_HOST=https://komodo.example.com
KOMODO_TITLE=Komodo
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=<FILL IN>
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_DISABLE_USER_REGISTRATION=true

# Generate each with: openssl rand -hex 32
# Webhook secret: also entered on the git provider's webhook.
KOMODO_WEBHOOK_SECRET=<FILL IN>
# Signs login sessions; changing it logs everyone out.
KOMODO_JWT_SECRET=<FILL IN>

# Optional OIDC login (e.g. authentik)
KOMODO_OIDC_ENABLED=false
# KOMODO_OIDC_PROVIDER=https://auth.example.com/application/o/komodo
# KOMODO_OIDC_CLIENT_ID=
# KOMODO_OIDC_CLIENT_SECRET=

# Komodo Periphery - full list: https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml
PERIPHERY_CORE_ADDRESS=ws://komodo-core:9120
PERIPHERY_CONNECT_AS=Local
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname

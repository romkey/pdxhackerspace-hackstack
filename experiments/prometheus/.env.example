IMAGE_VERSION=latest
NODE_EXPORTER_IMAGE_VERSION=latest
CADVISOR_IMAGE_VERSION=latest
NUT_EXPORTER_IMAGE_VERSION=latest
# SNMP_EXPORTER_IMAGE_VERSION=latest
TZ=America/Los_Angeles

# How long to keep metrics
PROMETHEUS_RETENTION=90d

# nut-exporter - upsd publishes 3493 on the host
NUT_EXPORTER_SERVER=host.docker.internal
NUT_EXPORTER_SERVERPORT=3493
# Only needed if upsd requires a login to read variables
# NUT_EXPORTER_USERNAME=
# NUT_EXPORTER_PASSWORD=

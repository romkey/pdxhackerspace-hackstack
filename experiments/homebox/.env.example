# Container image tag (see https://github.com/sysadminsmedia/homebox/pkgs/container/homebox )
IMAGE_VERSION=latest

# Optional: timezone inside the container
# TZ=America/Los_Angeles

# PostgreSQL password for homebox_user (create DB/user first; see README).
# Do not commit real values — keep them only in .env.
HBOX_DATABASE_PASSWORD=

# Optional overrides (defaults match config.yml when copied from config/config.yml.default):
# HBOX_DATABASE_DRIVER=postgres
# HBOX_DATABASE_HOST=postgresql
# HBOX_DATABASE_PORT=5432
# HBOX_DATABASE_USERNAME=homebox_user
# HBOX_DATABASE_DATABASE=homebox_db
# HBOX_DATABASE_SSL_MODE=disable

# SMTP
#HBOX_MAILER_HOST=mail-relay
#HBOX_MAILER_PORT=25
#HBOX_MAILER_USERNAME=
#HBOX_MAILER_PASSWORD=
#HBOX_MAILER_FROM=info@pdxhackerspace.org

# HomeBox merges /data/config.yml with HBOX_* variables (see https://homebox.software/ ).
# HBOX_OPTIONS_TRUST_PROXY=true

HBOX_OPTIONS_ALLOW_LOCAL_LOGIN=true
HBOX_OPTIONS_ALLOW_REGISTRATION=false

# OIDC
HBOX_OIDC_ENABLED=true
HBOX_OIDC_ISSUER_URL=
HBOX_OIDC_CLIENT_ID=
HBOX_OIDC_CLIENT_SECRET=

HBOX_OPTIONS_TRUST_PROXY=true

HBOX_OPTIONS_HOSTNAME=assets.pdxhackerspace.org
# BACKUP_DATABASE_URLS — apps/postgresql/bin/mkdb.sh or apps/mariadb/bin/mkdb.sh appends this to .env when you
# create the app database (unless .env already defines it). For SQLite or other URLs, set it only in your
# real .env. Do not define BACKUP_DATABASE_URLS in .env.example.

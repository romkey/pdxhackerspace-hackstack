# Official tags: lts, stable, latest (see https://hub.docker.com/_/mediawiki )
IMAGE_VERSION=lts

# Optional
# TZ=America/Los_Angeles

# BACKUP_DATABASE_URLS — apps/mariadb/bin/mkdb.sh appends this to .env when you create the app
# database (unless .env already defines it). Do not define BACKUP_DATABASE_URLS in .env.example.

# --- Optional: uploaded images on NFS ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.nfs.yml
# MEDIAWIKI_NFS_HOST=
# MEDIAWIKI_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

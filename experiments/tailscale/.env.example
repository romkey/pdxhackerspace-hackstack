# Pin the client. Headscale 0.29.3 rejects clients older than 1.80
# (see https://github.com/tailscale/tailscale/releases )
IMAGE_VERSION=v1.102.2

# Optional
# TZ=America/Los_Angeles

# Pre-auth key from `headscale preauthkeys create`. Only read on first login;
# after that the node key in ../../lib/tailscale is what authenticates.
TS_AUTHKEY=

# Name the node registers under, and its MagicDNS name within the tailnet.
TS_HOSTNAME=hackstack

# --login-server is what points this client at headscale instead of Tailscale's
# SaaS. Add --advertise-exit-node here to offer this host as an exit node
# (requires network_mode: host in docker-compose.yml), and --accept-routes to
# use subnet routes other nodes advertise.
TS_EXTRA_ARGS=--login-server=https://headscale.example.org

# Kernel networking via /dev/net/tun. The image defaults to userspace
# networking, which cannot route subnets or serve as an exit node.
TS_USERSPACE=false

TS_STATE_DIR=/var/lib/tailscale

# Log in only when there is no state yet, instead of on every container start.
TS_AUTH_ONCE=true

# Subnet routes to advertise, comma separated. They stay inactive until approved
# with `headscale nodes approve-routes` (see README).
# TS_ROUTES=192.168.1.0/24

# Let headscale's MagicDNS configuration overwrite the container's resolv.conf.
# Off here because the container only needs to reach headscale by name.
TS_ACCEPT_DNS=false

# /healthz on 9002, which the compose healthcheck probes. In host networking
# this binds port 9002 on the host.
TS_ENABLE_HEALTH_CHECK=true
TS_LOCAL_ADDR_PORT=0.0.0.0:9002

# Prometheus client metrics on the same address, at /metrics
# TS_ENABLE_METRICS=false

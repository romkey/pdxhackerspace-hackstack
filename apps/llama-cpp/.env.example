# ==== hardware: pick exactly one COMPOSE_FILE line ===========================
# See README "Choosing compose files". Add :docker-compose.nfs.yml to the end of
# any line to keep models on NFS.

# CPU only
COMPOSE_FILE=docker-compose.yml
# NVIDIA discrete GPUs, CUDA 12.8 (driver >= 570)
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# NVIDIA DGX Spark (GB10), CUDA 13
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.spark.yml
# NVIDIA Jetson Thor (uses the nvidia runtime instead of GPU reservations)
# COMPOSE_FILE=docker-compose.yml:docker-compose.jetson.yml
# AMD Strix Halo / Strix Point (Vulkan), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.strix.yml
# Intel Arc (SYCL), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.arc.yml

# Full image tag. Leave unset: each compose file picks its own default
#   server (CPU), server-cuda, server-cuda13, server-vulkan, server-rocm, server-intel
# Set it to pin a build, e.g. server-cuda-b6500, or to switch backend within a
# file (server-cuda13 on nvidia.yml, server-rocm on strix.yml, server-vulkan on arc.yml).
# IMAGE_VERSION=

# ==== model ===================================================================
# Path to the GGUF model file inside the container
LLAMA_ARG_MODEL=/models/model.gguf

# Bind host and port inside the container
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080

# ==== Hugging Face downloads ==================================================
# Only used when llama.cpp downloads the model itself, e.g.
#   LLAMA_ARG_HF_REPO=unsloth/Qwen3.8-27B-GGUF:Q4_K_M   (instead of LLAMA_ARG_MODEL)
# Keep downloads on the models volume; otherwise they land in the container's
# own cache and are fetched again whenever it is recreated:
# HF_HUB_CACHE=/models/hf-cache
# Read-only token, for gated repos
# HF_TOKEN=
# Download from a Hugging Face-compatible mirror (MODEL_ENDPOINT also works and wins)
# HF_ENDPOINT=http://hf-mirror.ctrlh
# Use only what is already in the cache, without contacting the Hub
# LLAMA_ARG_OFFLINE=1

# ==== llama.cpp server (all backends) =========================================
# Defaults shown. The platform sections below suggest tuned values: uncomment
# the ones for your hardware (only one value per variable takes effect).
#
# GPU layers and context size are fitted to free device memory automatically
# (--fit on). Setting either one pins it and turns fitting off for it.
# unset = auto; 0 = CPU only; 999 = all
# LLAMA_ARG_N_GPU_LAYERS=
LLAMA_ARG_CTX_SIZE=4096             # 0 = the model's trained context
# LLAMA_ARG_FIT=on
# LLAMA_ARG_FIT_TARGET=1024         # MiB to leave free per device when fitting
# default: all cores; set to physical cores
# LLAMA_ARG_THREADS=
# parallel slots (context is split between them)
# LLAMA_ARG_N_PARALLEL=
# LLAMA_ARG_FLASH_ATTN=auto         # on | off | auto
# LLAMA_ARG_CACHE_TYPE_K=f16        # f16 | q8_0 | q4_0 (quantized V needs flash attention)
# LLAMA_ARG_CACHE_TYPE_V=f16
# LLAMA_ARG_BATCH=2048              # logical batch size
# LLAMA_ARG_UBATCH=512              # physical batch size; larger speeds prompt processing on big GPUs
# LLAMA_ARG_LOAD_MODE=auto          # auto | none (no mmap) | mmap | mlock | mmap+mlock | dio
# LLAMA_ARG_JINJA=1                 # use the model's chat template (tool calling)

# ==== NVIDIA discrete GPUs (nvidia.yml) =======================================
# GPUs reserved for the container: all, or a number
# GPU_COUNT=all
# CUDA_VISIBLE_DEVICES=0
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_CACHE_TYPE_K=q8_0
# LLAMA_ARG_CACHE_TYPE_V=q8_0
# LLAMA_ARG_CTX_SIZE=32768
# LLAMA_ARG_N_PARALLEL=2
# LLAMA_ARG_UBATCH=1024
# Multi-GPU: layer (default) | row | tensor; tensor split by VRAM ratio, main GPU index
# LLAMA_ARG_SPLIT_MODE=layer
# LLAMA_ARG_TENSOR_SPLIT=3,1
# LLAMA_ARG_MAIN_GPU=0
# MoE models larger than VRAM: keep the experts of the first N layers on the CPU
# LLAMA_ARG_N_CPU_MOE=10
# Spill to system RAM instead of failing when VRAM runs out (slow)
# GGML_CUDA_ENABLE_UNIFIED_MEMORY=1

# --- DGX Spark (GB10, 20 cores, 128 GB unified memory; nvidia.yml + spark.yml) -
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_CTX_SIZE=131072
# LLAMA_ARG_N_PARALLEL=4
# LLAMA_ARG_BATCH=2048
# LLAMA_ARG_UBATCH=2048
# LLAMA_ARG_THREADS=20
# LLAMA_ARG_LOAD_MODE=none          # much faster loads on unified memory than mmap
# LLAMA_ARG_FIT_TARGET=24576        # leave 24 GiB for the OS and co-resident services

# ==== Jetson Thor (14 cores, 128 GB unified memory; jetson.yml) ===============
# On the host: sudo nvpmodel -m 0 && sudo jetson_clocks
# NVIDIA_VISIBLE_DEVICES=all
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_CTX_SIZE=65536
# LLAMA_ARG_N_PARALLEL=2
# LLAMA_ARG_UBATCH=1024
# LLAMA_ARG_THREADS=14
# LLAMA_ARG_LOAD_MODE=none
# LLAMA_ARG_FIT_TARGET=16384

# ==== AMD Strix (strix.yml) ===================================================
# Raise the GPU's share of system memory on the host first (see README).
# Pick one Vulkan device if the host has more than one GPU:
# GGML_VK_VISIBLE_DEVICES=0
# Strix Halo (Ryzen AI Max, 16 cores, up to 128 GB shared):
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_CTX_SIZE=65536
# LLAMA_ARG_N_PARALLEL=2
# LLAMA_ARG_UBATCH=1024
# LLAMA_ARG_THREADS=16
# LLAMA_ARG_LOAD_MODE=none          # mmap loads are often very slow on these APUs
# Strix Point (Ryzen AI 300, 12 cores, memory shared with the desktop):
# LLAMA_ARG_CTX_SIZE=16384
# LLAMA_ARG_THREADS=12
# Only with IMAGE_VERSION=server-rocm:
# HSA_OVERRIDE_GFX_VERSION=11.5.1   # 11.5.0 for Strix Point; only if ROCm doesn't recognise the APU
# GGML_CUDA_ENABLE_UNIFIED_MEMORY=1 # let HIP allocate from shared system memory
# ROCBLAS_USE_HIPBLASLT=1           # faster prompt processing on RDNA 3.5

# ==== Intel Arc (arc.yml) =====================================================
# arc.yml already sets ZES_ENABLE_SYSMAN=1 so --fit can see free VRAM.
# Pick one card on a multi-GPU host
# ONEAPI_DEVICE_SELECTOR=level_zero:0
# LLAMA_ARG_SPLIT_MODE=none
# LLAMA_ARG_MAIN_GPU=0
# Arc B580 / A770 (12-16 GB):
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_CACHE_TYPE_K=q8_0
# LLAMA_ARG_CACHE_TYPE_V=q8_0
# LLAMA_ARG_CTX_SIZE=16384
# LLAMA_ARG_N_PARALLEL=1
# Only with IMAGE_VERSION=server-vulkan, if output is garbled:
# GGML_VK_DISABLE_COOPMAT=1

# ==== CPU only (docker-compose.yml alone) =====================================
# LLAMA_ARG_THREADS=8               # physical cores, not hyperthreads
# LLAMA_ARG_CTX_SIZE=4096
# LLAMA_ARG_N_PARALLEL=1
# LLAMA_ARG_BATCH=512
# LLAMA_ARG_UBATCH=512
# LLAMA_ARG_CACHE_TYPE_K=q8_0
# LLAMA_ARG_CACHE_TYPE_V=q8_0
# LLAMA_ARG_FLASH_ATTN=on
# Multi-socket servers:
# LLAMA_ARG_NUMA=distribute

# --- Optional: GGUF models on NFS (append :docker-compose.nfs.yml to COMPOSE_FILE) ---
# LLAMA_CPP_NFS_HOST=
# LLAMA_CPP_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

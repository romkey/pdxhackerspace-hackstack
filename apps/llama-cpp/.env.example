# ==== hardware: pick exactly one COMPOSE_FILE line ===========================
# See README "Choosing compose files". Add :docker-compose.nfs.yml to the end of
# any line to keep models on NFS.

# CPU only
COMPOSE_FILE=docker-compose.yml
# NVIDIA discrete GPUs, CUDA 12.8 (driver >= 570)
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# NVIDIA DGX Spark (GB10), CUDA 13
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.spark.yml
# NVIDIA Jetson Thor (uses the nvidia runtime instead of GPU reservations)
# COMPOSE_FILE=docker-compose.yml:docker-compose.jetson.yml
# AMD Strix Halo / Strix Point (Vulkan), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.strix.yml
# Intel Arc (SYCL), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.arc.yml

# Full image tag. Leave unset: each compose file picks its own default
#   server (CPU), server-cuda, server-cuda13, server-vulkan, server-rocm, server-intel
# Set it to pin a build, e.g. server-cuda-b6500, or to switch backend within a
# file (server-cuda13 on nvidia.yml, server-rocm on strix.yml, server-vulkan on arc.yml).
# IMAGE_VERSION=

# ==== model ===================================================================
# Path to the GGUF model file inside the container
LLAMA_ARG_MODEL=/models/model.gguf

# Layers to offload to the GPU (0 = CPU only, 999 = all). Leave unset: the base
# file runs on the CPU and the GPU files default to 999.
# LLAMA_ARG_N_GPU_LAYERS=

# Context window size in tokens
LLAMA_ARG_CTX_SIZE=4096

# Number of CPU threads to use
LLAMA_ARG_THREADS=4

# Bind host and port inside the container
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080

# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_N_PARALLEL=1

# ==== NVIDIA (nvidia.yml, spark.yml, jetson.yml) ==============================
# GPUs reserved for the container: all, or a number (ignored on Jetson)
# GPU_COUNT=all
# CUDA_VISIBLE_DEVICES=0

# ==== AMD Strix (strix.yml) ===================================================
# Pick one Vulkan device if the host has more than one GPU:
# GGML_VK_VISIBLE_DEVICES=0
# Only for IMAGE_VERSION=server-rocm, if ROCm doesn't recognise the APU:
# HSA_OVERRIDE_GFX_VERSION=11.5.1   # 11.5.0 for Strix Point

# ==== Intel Arc (arc.yml) =====================================================
# Pick one card on a multi-GPU host
# ONEAPI_DEVICE_SELECTOR=level_zero:0

# --- Optional: GGUF models on NFS (append :docker-compose.nfs.yml to COMPOSE_FILE) ---
# LLAMA_CPP_NFS_HOST=
# LLAMA_CPP_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

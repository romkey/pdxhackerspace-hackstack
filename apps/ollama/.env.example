# ==== hardware: pick exactly one COMPOSE_FILE line ===========================
# See README "Choosing compose files". Add :docker-compose.nfs.yml to the end of
# any line to keep models on NFS.

# NVIDIA discrete GPUs and DGX Spark (GB10)
COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# NVIDIA Jetson Thor (uses the nvidia runtime instead of GPU reservations)
# COMPOSE_FILE=docker-compose.yml:docker-compose.jetson.yml
# AMD Strix Halo / Strix Point (ROCm), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.strix.yml
# Intel Arc (Vulkan), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.arc.yml
# CPU only
# COMPOSE_FILE=docker-compose.yml

# Ollama release (e.g. 0.40.11), or leave unset for latest. The Strix file adds
# the -rocm suffix itself, so don't include it here.
# IMAGE_VERSION=

# ==== Ollama (all backends) ===================================================
# Defaults shown. The platform sections below suggest tuned values: uncomment
# the ones for your hardware (only one value per variable takes effect).
# OLLAMA_KEEP_ALIVE=5m              # how long an idle model stays loaded; -1 = forever
# default: 4k/32k/256k depending on VRAM
# OLLAMA_CONTEXT_LENGTH=
# OLLAMA_NUM_PARALLEL=1             # parallel requests per model (each multiplies KV cache)
# default: 3 per GPU, 3 on CPU
# OLLAMA_MAX_LOADED_MODELS=
# OLLAMA_MAX_QUEUE=512
# OLLAMA_LOAD_TIMEOUT=5m            # raise for very large models on slow storage (NFS)
# OLLAMA_FLASH_ATTENTION=1          # needed for a quantized KV cache
# OLLAMA_KV_CACHE_TYPE=q8_0         # f16 | q8_0 (half the memory, ~no quality loss) | q4_0
# OLLAMA_DEBUG=1

# ==== NVIDIA discrete GPUs (docker-compose.nvidia.yml) ========================
# GPUs reserved for the container: all, or a number
GPU_COUNT=4
# GPU UUIDs or indexes, comma separated
# CUDA_VISIBLE_DEVICES=
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=2
# Multi-GPU: spread every model over all GPUs instead of packing onto the fewest
# OLLAMA_SCHED_SPREAD=1
# Bytes of VRAM to keep free per GPU (e.g. a display, or another service): 1 GiB
# OLLAMA_GPU_OVERHEAD=1073741824

# --- DGX Spark (GB10, 128 GB unified memory, nvidia.yml) ----------------------
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_CONTEXT_LENGTH=65536
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_MAX_LOADED_MODELS=3
# OLLAMA_KEEP_ALIVE=1h
# Leave room for the OS and co-resident services (vLLM, ComfyUI): 24 GiB
# OLLAMA_GPU_OVERHEAD=25769803776

# ==== Jetson Thor (128 GB unified memory, docker-compose.jetson.yml) ==========
# On the host: sudo nvpmodel -m 0 && sudo jetson_clocks
# NVIDIA_VISIBLE_DEVICES=all
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=1h
# OLLAMA_GPU_OVERHEAD=17179869184   # 16 GiB for the OS and other services

# ==== AMD Strix (docker-compose.strix.yml) ====================================
# Strix Halo (gfx1151) and Strix Point (gfx1150) are supported by the ROCm
# build. Only set this if Ollama falls back to the CPU on your APU:
# HSA_OVERRIDE_GFX_VERSION=11.5.1   # 11.5.0 for Strix Point
# ROCR_VISIBLE_DEVICES=0
# Strix Halo (up to 128 GB shared; raise the GPU's share on the host, see README):
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=1h
# Strix Point (smaller iGPU, memory shared with the desktop):
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_MAX_LOADED_MODELS=1
# The Vulkan backend (the docker-compose.arc.yml line) also runs on Strix; try it
# if ROCm misbehaves.

# ==== Intel Arc (docker-compose.arc.yml) ======================================
# Vulkan is on by default in that file; pick one card on a multi-GPU host:
# GGML_VK_VISIBLE_DEVICES=0
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# Arc B580 / A770 (12-16 GB):
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_NUM_PARALLEL=1
# Garbled output or crashes on some driver versions: turn off cooperative matrix
# GGML_VK_DISABLE_COOPMAT=1

# ==== CPU only (docker-compose.yml alone) =====================================
# Thread count is a per-model option (num_thread in a Modelfile), not an env var.
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_KEEP_ALIVE=30m             # reloading from disk is the slow part on CPU

# --- Optional: models on NFS (append :docker-compose.nfs.yml to COMPOSE_FILE) ---
# OLLAMA_NFS_HOST=
# OLLAMA_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

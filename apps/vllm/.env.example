# ==== hardware: pick exactly one COMPOSE_FILE line ===========================
# See README "Choosing compose files". Add :docker-compose.nfs.yml to the end of
# any line to keep the Hugging Face cache on NFS (Intel Arc: see arc.yml).

# NVIDIA discrete GPUs and DGX Spark, CUDA 13 (driver >= 580)
COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# NVIDIA DGX Spark with the community GB10 build
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.spark.yml
# NVIDIA Jetson Thor (uses the nvidia runtime instead of GPU reservations)
# COMPOSE_FILE=docker-compose.yml:docker-compose.jetson.yml
# AMD Strix Halo / Strix Point (ROCm), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.strix.yml
# Intel Arc (XPU), x86_64 only
# COMPOSE_FILE=docker-compose.yml:docker-compose.arc.yml
# CPU only (x86_64 with AVX-512 recommended, or arm64); slow, mainly for testing
# COMPOSE_FILE=docker-compose.yml

# ==== model ===================================================================
# Required: Hugging Face model id, or a path to weights visible inside the container
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# vLLM release tag (e.g. v0.32.0), or leave unset for latest. Applies to every
# image: vllm-openai, -cpu, -rocm and -xpu share version tags.
# NVIDIA with driver 575-579: IMAGE_VERSION=v0.32.0-cu129
# IMAGE_VERSION=

# ==== Hugging Face downloads ==================================================
# vLLM downloads models with huggingface_hub, which reads these. The cache is
# ../../lib/vllm/huggingface on the host (/root/.cache/huggingface inside), so
# leave HF_HOME / HF_HUB_CACHE alone.
#
# Read-only token, for gated models; also avoids rate limits on big pulls
# HF_TOKEN=
# Download from a Hugging Face-compatible mirror instead of huggingface.co
# HF_ENDPOINT=http://hf-mirror.ctrlh
# If downloads through the mirror fail or still go to huggingface.co, turn off
# Xet (chunked storage) transfers so every file comes through HF_ENDPOINT:
# HF_HUB_DISABLE_XET=1
# Use only what is already in the cache: no network at all, and a faster start
# HF_HUB_OFFLINE=1
# Saturate the network and CPUs for big downloads (Xet transfers only)
# HF_XET_HIGH_PERFORMANCE=1
# Seconds to wait for a slow server or mirror (defaults: 10 for metadata, 10 for files)
# HF_HUB_ETAG_TIMEOUT=30
# HF_HUB_DOWNLOAD_TIMEOUT=60
# HF_HUB_DISABLE_TELEMETRY=1
# Progress bars fill `docker compose logs` with redraws
# HF_HUB_DISABLE_PROGRESS_BARS=1
# Log every Hub request (debugging a mirror)
# HF_HUB_VERBOSITY=debug

# ==== vLLM engine flags =======================================================
# VLLM_ARGS holds extra `vllm serve` flags, space-separated. It is a single
# variable: uncomment exactly one VLLM_ARGS line, from your platform's section
# below or this generic one, and edit it to taste.
# VLLM_ARGS=--max-model-len 8192 --gpu-memory-utilization 0.9
#
# Flags worth knowing on every platform:
#   --max-model-len N             cap context; the biggest lever on KV cache memory
#   --gpu-memory-utilization F    fraction of device memory vLLM may claim (default 0.9)
#   --max-num-seqs N              concurrent sequences (default 256; lower saves memory)
#   --kv-cache-dtype fp8          halve KV cache memory (NVIDIA, and Instinct on ROCm)
#   --tensor-parallel-size N      split across N GPUs (match GPU_COUNT)
#   --enforce-eager               skip CUDA/HIP graph capture: less memory, faster start, slower decode
#   --served-model-name NAME      name clients see in /v1/models

# ==== NVIDIA discrete GPUs (nvidia.yml) =======================================
# GPUs reserved for the container: all, or a number (match --tensor-parallel-size)
# GPU_COUNT=1
# CUDA_VISIBLE_DEVICES=0
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Single 24-32 GB card:
# VLLM_ARGS=--gpu-memory-utilization 0.92 --max-model-len 32768 --kv-cache-dtype fp8 --max-num-seqs 32
# Two cards:
# VLLM_ARGS=--tensor-parallel-size 2 --gpu-memory-utilization 0.92 --max-model-len 32768 --kv-cache-dtype fp8
# 8-16 GB card:
# VLLM_ARGS=--gpu-memory-utilization 0.9 --max-model-len 8192 --max-num-seqs 8 --enforce-eager
# Consumer cards without NVLink that hang at startup with tensor parallel:
# NCCL_P2P_DISABLE=1

# --- DGX Spark (GB10, 128 GB unified memory; nvidia.yml, optionally spark.yml) -
# --gpu-memory-utilization is a share of the whole 128 GB; leave room for the OS
# and co-resident services (ollama, ComfyUI).
# VLLM_ARGS=--gpu-memory-utilization 0.7 --max-model-len 131072 --max-num-seqs 8 --kv-cache-dtype fp8 --moe-backend marlin --linear-backend cutlass
# Disable MLA attention (DeepSeek-style models) if it fails on GB10
# VLLM_MLA_DISABLE=1
# Tag of the community Spark image (spark.yml only)
# SPARK_IMAGE_VERSION=latest
# Older vLLM builds (possibly the community image) take these instead of
# --moe-backend / --linear-backend; current vLLM ignores them:
# VLLM_USE_FLASHINFER_MOE_FP4=0
# VLLM_MOE_BACKEND=marlin
# VLLM_FP4_BACKEND=VLLM_CUTLASS

# ==== Jetson Thor (128 GB unified memory; jetson.yml) =========================
# On the host: sudo nvpmodel -m 0 && sudo jetson_clocks
# NVIDIA_VISIBLE_DEVICES=all
# VLLM_ARGS=--gpu-memory-utilization 0.6 --max-model-len 32768 --max-num-seqs 8 --kv-cache-dtype fp8

# ==== AMD Strix (strix.yml) ===================================================
# Raise the GPU's share of system memory on the host first (see README).
# HIP_VISIBLE_DEVICES=0
# Only if ROCm doesn't recognise the APU:
# HSA_OVERRIDE_GFX_VERSION=11.5.1   # 11.5.0 for Strix Point
# AITER kernels are MI300/MI350-only; keep them off (the default)
# VLLM_ROCM_USE_AITER=0
# Strix Halo (up to 128 GB shared):
# VLLM_ARGS=--gpu-memory-utilization 0.7 --max-model-len 32768 --max-num-seqs 8
# Strix Point (memory shared with the desktop):
# VLLM_ARGS=--gpu-memory-utilization 0.5 --max-model-len 8192 --max-num-seqs 4 --enforce-eager

# ==== Intel Arc (arc.yml) =====================================================
# Pick one card on a multi-GPU host
# ONEAPI_DEVICE_SELECTOR=level_zero:0
# ZE_AFFINITY_MASK=0
# Arc B580 (12 GB):
# VLLM_ARGS=--dtype bfloat16 --gpu-memory-utilization 0.9 --max-model-len 8192 --max-num-seqs 8
# Two Arc Pro B60 (24 GB each):
# VLLM_ARGS=--dtype bfloat16 --tensor-parallel-size 2 --distributed-executor-backend mp --gpu-memory-utilization 0.9 --max-model-len 32768

# ==== CPU only (docker-compose.yml alone) =====================================
# GiB of RAM for the KV cache (0 = vLLM picks)
# VLLM_CPU_KVCACHE_SPACE=16
# Cores for the OpenMP threads: auto (per NUMA node), a list like 0-15, or nobind
# VLLM_CPU_OMP_THREADS_BIND=auto
# Cores kept free for the server process when binding is auto
# VLLM_CPU_NUM_OF_RESERVED_CPU=1
# float16 is unstable on CPU; bfloat16 is the recommended dtype
# VLLM_ARGS=--dtype bfloat16 --max-model-len 4096 --max-num-seqs 4

# --- Optional: Hugging Face cache on NFS (append :docker-compose.nfs.yml to COMPOSE_FILE) ---
# VLLM_NFS_HOST=
# VLLM_NFS_PATH=
# NFS_MOUNT_OPTS=nfsvers=4,hard

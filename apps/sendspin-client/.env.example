IMAGE_VERSION=latest
# Sendspin Server
SENDSPIN_SERVER=http://ma.ctrlh

# Client Identity
SENDSPIN_NAME="s2 speakers (sendspin)"         # Friendly name shown in Music Assistant
SENDSPIN_ID=s2-speakers-sendspin      # Unique ID (change per device if running multiple Pis)

# Audio
CARD=0                          # ALSA card index — run `aplay -l` to find yours
# --- Optional: LAN macvlan (see README and docs/macvlan.md) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.macvlan.yml
# LAN_NET_NAME=lan_macvlan
# MACVLAN_PARENT=enp45s0
# MACVLAN_SUBNET=10.0.0.0/24
# MACVLAN_GATEWAY=10.0.1.1
# MACVLAN_IP_RANGE=10.0.1.0/24
# IPV4_ADDRESS=
# LAN_MAC_ADDRESS=
